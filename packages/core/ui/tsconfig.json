{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@bagos/contracts": ["../contracts/src/index.ts"],
      "@bagos/fixtures": ["../fixtures/src/index.ts"],
